rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: All visitors can read, create and update their account
    match /users/{userId} {
      allow read, write: if true;
    }

    // Articles collection: All visitors can read, author can publish/edit/delete
    match /articles/{articleId} {
      allow read, write: if true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
