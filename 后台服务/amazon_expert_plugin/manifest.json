{
  "manifest_version": 3,
  "name": "亚马逊专家级选品系统 V21.0",
  "version": "21.0",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.amazon.com/s?*", "https://www.amazon.com/dp/*"],
    "js": ["content.js"]
  }]
}