{
  "manifest_version": 3,
  "name": "亚马逊专家级选品系统 V21.0",
  "version": "21.0",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": [
      "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.se/*",
    "https://*.amazon.pl/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.in/*",
    "https://*.amazon.sg/*",
    "https://*.amazon.ae/*",
    "https://*.amazon.sa/*",
    "https://*.amazon.eg/*",
    "https://*.amazon.com.tr/*",
    "https://*.amazon.com.be/*"
    ],
    "js": ["content.js"]
  }]
}
